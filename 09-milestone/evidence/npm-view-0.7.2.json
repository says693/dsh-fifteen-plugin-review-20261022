      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:surface": "playwright test --config=qa/playwright.config.ts",
    "prepublishOnly": "pnpm run build"
  },
  "license": "MIT",
